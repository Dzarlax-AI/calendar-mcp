LISTEN_ADDR=:8080
WORKER_HEALTH_ADDR=127.0.0.1:8082
API_KEY=your-api-key-here
# Unsafe local-only escape hatch. Production should keep this false.
ALLOW_UNAUTHENTICATED=false
ENABLE_V2=false
TOKEN_DIR=/app/data

# Calendar platform mode (web UI + persisted connections + sync worker)
# PostgreSQL is recommended for production:
# DATABASE_URL=postgres://calendar:change-me@postgres:5432/calendar?sslmode=disable
# SQLite remains supported for a small self-hosted installation:
DATABASE_URL=sqlite:///app/data/calendar.db
CALENDAR_ENCRYPTION_KEY=base64-encoded-32-byte-key
CALENDAR_PUBLIC_URL=http://localhost:8080
UI_TRUST_FORWARD_AUTH=true
# Local-only bypass. Keep false whenever the port is reachable by other users.
UI_ALLOW_UNAUTHENTICATED=false

# Google Calendar (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy env/token-file mode only. Web-connected credentials are encrypted in DB.
GOOGLE_REFRESH_TOKEN=

# Microsoft 365 (OAuth2 / Azure AD)
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REFRESH_TOKEN=

# Apple iCloud (CalDAV)
APPLE_USERNAME=
APPLE_APP_PASSWORD=
APPLE_CALDAV_URL=https://caldav.icloud.com
