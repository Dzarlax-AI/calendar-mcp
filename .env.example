LISTEN_ADDR=:8080
WORKER_HEALTH_ADDR=127.0.0.1:8082
API_KEY=your-api-key-here
# Optional previous key accepted temporarily during credential rotation.
# Remove it after every client has migrated to API_KEY.
API_KEY_LEGACY=
# Unsafe local-only escape hatch. Production should keep this false.
ALLOW_UNAUTHENTICATED=false
ENABLE_V2=false
TOKEN_DIR=/app/data

# Required by the Compose examples. Supply immutable image references such as
# registry.example/image@sha256:<release-digest>; do not use mutable tags.
CALENDAR_IMAGE=
# Required only by docker-compose.postgres.example.yml. Use a reviewed
# PostgreSQL 17 image digest.
POSTGRES_IMAGE=
# Must be URL-safe because Compose embeds it in DATABASE_URL.
CALENDAR_POSTGRES_PASSWORD=
# Optional override for an external/shared PostgreSQL instance. Such instances
# must use sslmode=verify-full and a trusted sslrootcert.
# CALENDAR_DATABASE_URL=postgres://calendar:<url-safe-password>@db.example.com/calendar?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem

# Calendar platform mode (web UI + persisted connections + sync worker)
# PostgreSQL is recommended for production. The non-TLS URL below is valid only
# for the bundled database on the private Compose network:
# DATABASE_URL=postgres://calendar:<url-safe-password>@postgres:5432/calendar?sslmode=disable
# SQLite remains supported for a small self-hosted installation:
DATABASE_URL=sqlite:///app/data/calendar.db
CALENDAR_ENCRYPTION_KEY=base64-encoded-32-byte-key
CALENDAR_PUBLIC_URL=http://localhost:8080
# Optional read-only API for the native app. Generate once, store it as a
# deployment secret, and keep it unchanged while clients use it. For a public
# URL, set NATIVE_APP_TRUSTED_PROXY=true only behind an HTTPS reverse proxy.
# NATIVE_APP_TOKEN=
# NATIVE_APP_TRUSTED_PROXY=false
# Enable only behind a trusted proxy that strips client-supplied
# X-authentik-username and keeps the application listener unreachable directly.
UI_TRUST_FORWARD_AUTH=false
# Local-only bypass. Keep false whenever the port is reachable by other users.
# For local-only use, set this true together with UI_TRUST_FORWARD_AUTH=false.
UI_ALLOW_UNAUTHENTICATED=false
# Comma-separated Authentik usernames allowed to inspect encrypted raw sync
# artifacts. Empty by default; raw diagnostics remain unavailable to all UI users.
UI_RAW_ARTIFACT_USERS=

# Google Calendar (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy env/token-file mode only. Web-connected credentials are encrypted in DB.
GOOGLE_REFRESH_TOKEN=

# Microsoft 365 (OAuth2 / Azure AD)
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REFRESH_TOKEN=

# Apple iCloud (CalDAV)
APPLE_USERNAME=
APPLE_APP_PASSWORD=
APPLE_CALDAV_URL=https://caldav.icloud.com
